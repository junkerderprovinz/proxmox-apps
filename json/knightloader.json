  "description": "A download manager for hosters, debrid services, torrents, Usenet and video sites. It brings a headless JDownloader, yt-dlp and a browser for links that need one.",
  "install_methods": [
    {
      "type": "default",
      "script": "ct/knightloader.sh",
      "config_path": "/etc/systemd/system/knightloader.service",
      "resources": {
        "cpu": 2,
        "ram": 2048,
        "hdd": 12,
        "os": "Debian",
        "version": "13"
      }
    }
  ],
  "default_credentials": {
    "username": null,
    "password": null
  },
  "notes": [
    {
      "text": "Downloads land in /opt/knightloader/data/downloads. Mount your download folder there before the first download.",
      "type": "info"
    },
    {
      "text": "Click'n'Load container files (DLC) need the key that only the official image carries, so they do not open here.",
      "type": "warning"
    }
  ]
